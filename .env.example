# FOX PLAYER — Environment Configuration

# Server
PORT=3001

# Pairing URL (what the QR code points to)
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_PAIRING_BASE_URL=http://localhost:3001

# Database
DATABASE_PATH=./database/foxplayer.db

# Security
ENCRYPTION_KEY=change_this_to_a_random_32_char_secret_key
API_SECRET=change_this_secret

# CORS
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8081

# Logging
LOG_LEVEL=info
